# Dependencies
# Trailing slash + no leading slash: matches node_modules at ANY depth, which
# matters here because npm workspaces symlinks each package into the root
# node_modules (node_modules/@webarkit/cv-backend-spec -> packages/...).
# Following that link while staging produces an unbounded recursion of
# packages/<pkg>/node_modules/@webarkit/<pkg>/node_modules/... paths.
node_modules/

# Build output. Published packages declare their own `files` field, so npm
# still ships dist/ even though git ignores it — it is rebuilt, never committed.
dist/
*.tsbuildinfo

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs / caches
*.log
npm-debug.log*
.npm/

# Rust build output. `crates/*/target` cannot occur with a workspace, but the
# fuzz crate is its own workspace and has its own.
/target/
crates/wnft-format/fuzz/target/
crates/wnft-format/fuzz/corpus/
crates/wnft-format/fuzz/artifacts/
crates/wnft-format/fuzz/coverage/
# The fuzz crate is its own workspace (see above), so `cargo check`/`cargo
# fuzz` inside it regenerates this lockfile — a plain `cargo check` at the
# repository root never touches it, so it does not belong in version control.
crates/wnft-format/fuzz/Cargo.lock

# Claude Code personal overrides. .claude/settings.json is shared and checked
# in; settings.local.json is per-developer and must not be.
.claude/settings.local.json
