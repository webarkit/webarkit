{
  "name": "@webarkit/webarkit",
  "private": true,
  "license": "LGPL-3.0-or-later",
  "description": "webarkit organization monorepo — shared contracts and packages for the WebAR toolchain (jsfeatNext, PureCV, high-level AR project).",
  "workspaces": [
    "packages/*"
  ],
  "//": "#212: --testTimeout=15000 on test:examples, against contention on loaded machines: the slowest sighting was 11.3 s (#210), the slowest measured 11.49 s with three suites at once, about 1.3× under 15 s.",
  "scripts": {
    "build": "node scripts/build-provenance.mjs",
    "prepare": "npm run build",
    "test": "npm run test --workspaces --if-present && npm run test:examples",
    "test:examples": "vitest run --root examples --testTimeout=15000",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:contract": "node scripts/check-contract-sync.mjs",
    "check:page": "node scripts/page-check.mjs",
    "check:provenance": "node scripts/provenance-preflight.mjs",
    "check:replay": "node scripts/replay-decoding-check.mjs",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"packages/*/ground-truth/**/*.ts\" \"packages/*/bin/*.mjs\" \"scripts/*.mjs\" \"examples/js/**/*.mjs\" \"examples/test/**/*.mjs\" \"**/*.md\"",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "puppeteer-core": "25.13.0",
    "vitest": "^4.1.11"
  }
}
