{
  "name": "@webarkit/webarkit",
  "private": true,
  "license": "LGPL-3.0-or-later",
  "description": "webarkit organization monorepo — shared contracts and packages for the WebAR toolchain (jsfeatNext, PureCV, high-level AR project).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @webarkit/cv-backend-spec && npm run build -w @webarkit/cv-backend-jsfeatnext && npm run build -w @webarkit/nft-tracker && npm run build:worker",
    "build:worker": "esbuild examples/js/detection-worker.mjs --bundle --format=esm --platform=browser --target=es2022 --outfile=examples/dist/detection-worker.mjs",
    "prepare": "npm run build",
    "test": "npm run test --workspaces --if-present && npm run test:examples",
    "test:examples": "vitest run --root examples",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:contract": "node scripts/check-contract-sync.mjs",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"packages/*/bin/*.mjs\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"packages/*/bin/*.mjs\" \"scripts/*.mjs\"",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "vitest": "^4.1.11"
  }
}
