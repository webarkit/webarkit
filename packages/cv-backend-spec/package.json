{
  "name": "@webarkit/cv-backend-spec",
  "version": "0.1.0",
  "description": "Minimal stateless CV backend interface shared by jsfeatNext and PureCV \u00e2\u20ac\u201d detect, describe, match, estimateHomography, poseFromHomography.",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./purity": {
      "types": "./dist/purity.d.ts",
      "import": "./dist/purity.js",
      "default": "./dist/purity.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "webarkit",
    "computer-vision",
    "webar",
    "augmented-reality",
    "interface"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/webarkit/webarkit.git",
    "directory": "packages/cv-backend-spec"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
