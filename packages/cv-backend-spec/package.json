{
  "name": "@webarkit/cv-backend-spec",
  "version": "0.7.0",
  "description": "Minimal stateless CV backend interface shared by jsfeatNext and PureCV — detect, describe, match, estimateHomography, poseFromHomography.",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./purity": {
      "types": "./dist/purity.d.ts",
      "import": "./dist/purity.js",
      "default": "./dist/purity.js"
    }
  },
  "files": [
    "dist"
  ],
  "//": "#212: --testTimeout=15000 on test, against contention on loaded machines: the slowest sighting was 11.3 s (#210), the slowest measured 11.49 s with three suites at once, about 1.3× under 15 s.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --testTimeout=15000",
    "test:watch": "vitest"
  },
  "keywords": [
    "webarkit",
    "computer-vision",
    "webar",
    "augmented-reality",
    "interface"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/webarkit/webarkit.git",
    "directory": "packages/cv-backend-spec"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
