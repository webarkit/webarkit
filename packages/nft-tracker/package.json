{
  "name": "@webarkit/nft-tracker",
  "version": "0.9.0",
  "private": true,
  "description": "Natural-feature tracking for planar image targets, written above the @webarkit/cv-backend-spec CvBackend contract.",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "//": "#212: --testTimeout=15000 on test and test:watch, against contention on loaded machines: the slowest sighting was 11.3 s (#210), the slowest measured 11.49 s with three suites at once, about 1.3× under 15 s.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --testTimeout=15000",
    "test:watch": "vitest --testTimeout=15000",
    "fixtures": "npm run build && node scripts/generate-fixtures.mjs",
    "compile-target": "node bin/compile-target.mjs",
    "validate-target": "node bin/validate-target.mjs"
  },
  "keywords": [
    "webarkit",
    "webar",
    "nft",
    "tracking",
    "computer-vision"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/webarkit/webarkit.git",
    "directory": "packages/nft-tracker"
  },
  "dependencies": {
    "@webarkit/cv-backend-spec": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@webarkit/cv-backend-jsfeatnext": "0.9.0",
    "fast-check": "^4.10.0",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
